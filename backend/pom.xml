<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bidarena</groupId>
  <artifactId>bid-arena-backend</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <solon.version>3.10.7</solon.version>
    <mysql.version>8.4.0</mysql.version>
    <flyway.version>10.20.1</flyway.version>
    <hikari.version>4.0.3</hikari.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Solon Web (HTTP + JSON) -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-web</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- WebSocket support (netty based) -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-boot-websocket-netty</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- SqlUtils data access + @Tran transactions -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-data-sqlutils</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- OpenAPI / Swagger UI -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-docs-openapi2</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- Logging -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-logging-logback</artifactId>
      <version>${solon.version}</version>
    </dependency>

    <!-- Connection pool -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
    </dependency>

    <!-- MySQL driver -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
    </dependency>

    <!-- Flyway migrations -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- Password hashing -->
    <dependency>
      <groupId>at.favre.lib</groupId>
      <artifactId>bcrypt</artifactId>
      <version>0.10.2</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-test</artifactId>
      <version>${solon.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>bid-arena-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- Solon 路由/参数绑定依赖参数名反射，必须保留 -parameters -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- 集成测试使用独立的本机测试库，不触碰开发库 bid_arena -->
          <environmentVariables>
            <BID_DB_URL>jdbc:mysql://localhost:3306/bid_arena_test?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC</BID_DB_URL>
            <BID_DB_USER>root</BID_DB_USER>
            <BID_DB_PASSWORD>123456</BID_DB_PASSWORD>
          </environmentVariables>
          <includes>
            <include>**/*IT.java</include>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
