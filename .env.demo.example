# Bid Arena 演示环境环境变量示例（复制为 .env.demo 后使用；.env.demo 不入 Git）
# 仅供 scripts/demo-docker.ps1 使用：独立项目 bid-arena-demo、独立数据卷、独立端口，
# 与原开发实例(8090/8091/5173)和验收实例(13306/18090/18091/15173)互不冲突。
# 必填：MySQL root 密码（demo-docker.ps1 会在 .env.demo 缺失时自动生成随机密码）

MYSQL_PORT=23306
MYSQL_DATABASE=bid_arena
MYSQL_ROOT_PASSWORD=change-me-demo-root-password

BACKEND_HTTP_PORT=28090
BACKEND_WS_PORT=28091
FRONTEND_PORT=25173
BID_DB_POOL_MAX=20
