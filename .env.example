# Bid Arena 环境变量示例（复制为 .env 后按需修改；.env 不入 Git）
# 供 docker-compose.yml 与本地脚本使用。后端读取 BID_DB_*（见 backend DbConfig.java）。

# ---- MySQL（Compose 内服务名 mysql；本机直连用 localhost）----
BID_DB_URL=jdbc:mysql://localhost:3306/bid_arena?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
BID_DB_USER=root
BID_DB_PASSWORD=change-me-root-password
BID_DB_POOL_MAX=20

# ---- 后端端口（默认 8090/8091，避免与本机 8080 冲突）----
BACKEND_HTTP_PORT=8090
BACKEND_WS_PORT=8091

# ---- MySQL 容器 ----
MYSQL_PORT=3306
MYSQL_DATABASE=bid_arena

# ---- 前端 ----
FRONTEND_PORT=5173

# ---- 模拟器 / 黑盒测试 ----
BID_API_BASE=http://127.0.0.1:8090
BID_WS_BASE=ws://127.0.0.1:8091
BID_ADMIN_EMAIL=admin@example.com
BID_ADMIN_PASSWORD=Admin123456!
BID_BOT_EMAIL_PATTERN=bot_%02d@example.com
BID_BOT_PASSWORD=Test123456!
# 可选：默认拍卖与随机种子
# BID_AUCTION_ID=1
# BID_SEED=42
